rules_version = '2';

// Copy this into Firebase console → Firestore Database → Rules, then Publish.
// It allows read/write only to clients that are signed in (the app signs
// everyone in anonymously on load), which keeps random internet crawlers out
// while letting your team's devices sync freely. See README.md for how this
// fits into setup, and for a note on tightening it further if you ever need to.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
